<%- include('partials/header', { title, nav: 'login' }) %>
<section class="auth-grid">
  <article class="card auth-form">
    <div class="auth-meta">
      <div>
        <p class="eyebrow">Sign in</p>
        <h1>Login to BusGo</h1>
      </div>
      <span class="status-badge">Session login</span>
    </div>
    <form method="post" action="/login">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" placeholder="Enter your email" required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" placeholder="Enter your password" required>
      <p class="auth-note">Admin users can log in with the seeded admin account to manage buses and bookings.</p>
      <div class="auth-actions">
        <button class="button primary" type="submit">Login</button>
        <a class="button secondary" href="/register">Create account</a>
      </div>
    </form>
  </article>
</section>
<%- include('partials/footer') %>
