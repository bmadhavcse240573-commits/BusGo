<%- include('partials/header', { title, nav: 'home' }) %>
<section class="hero-grid">
  <article class="hero-copy card">
    <p class="eyebrow">Bus reservation system</p>
    <h1>Reserve your next trip in a clean, simple flow.</h1>
    <p class="lead">Search buses, compare options, pick seats, and confirm bookings with a routed Express app backed by JSON persistence.</p>
    <p class="eyebrow">Automated local deployment enabled</p>
    <div class="hero-actions">
      <a class="button primary" href="/buses">Browse Buses</a>
      <a class="button secondary" href="/register">Create Account</a>
    </div>
  </article>

  <aside class="hero-panel card">
    <h2>Quick facts</h2>
    <div class="stats-grid">
      <div class="stat-box"><span>Routes</span><strong>24</strong></div>
      <div class="stat-box"><span>Daily buses</span><strong>86</strong></div>
      <div class="stat-box"><span>Average rating</span><strong>4.8</strong></div>
      <div class="stat-box"><span>Seat types</span><strong>AC / Sleeper</strong></div>
    </div>
  </aside>
</section>

<section class="feature-grid">
  <article class="info-card card"><h3>Search routes</h3><p>Start with origin, destination, and travel date to quickly narrow down buses.</p></article>
  <article class="info-card card"><h3>Choose seats</h3><p>Select your preferred seat layout from a visual seat map designed for fast decisions.</p></article>
  <article class="info-card card"><h3>Confirm booking</h3><p>Review passenger details and booking summary before submitting the reservation.</p></article>
</section>
<%- include('partials/footer') %>
